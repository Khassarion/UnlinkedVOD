      "staticFields": {
        "groupSong": false
      }
    },
    {
      "linePrefix": "🎶",
      "regexSequence": "\\s*{songTitle}{songArtist?}\\s*{time}\\s*{groupMembers}\\s*$",
      "staticFields": {
        "groupSong": true
      }
    }
  ],
  "parts": {
    "songTitle": "(.+?)",
    "songArtist": "(?<!\\\\)\\s+\\(((?:[^()]|\\([^()]*\\))+)\\)",
    "time": "(\\d{1,2}:\\d{1,2}(?::\\d{1,2})?)",
    "groupMembers": "\\(([^)]*)\\)",
    "comment": "/(\\*.*?\\*\\/)"
  },
  "regexSequence": "\\s*{songTitle}{songArtist?}\\s*{time}\\s*$",
